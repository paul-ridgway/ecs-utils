{
  "name": "ecs-utils",
  "version": "1.2.4",
  "description": "A little utility to quickly manage ECS Clusters, Services and Tasks from the command line",
  "main": "lib/index.js",
  "type": "module",
  "bin": {
    "ecs-utils": "./lib/index.js",
    "ecsutils": "./lib/index.js"
  },
  "scripts": {
    "start": "npx tsx src/index.ts",
    "build": "tsc -p .",
    "check": "npm run compile && npm run lint:all",
    "compile:watch": "tsc --watch --noEmit --skipLibCheck",
    "compile": "tsc --noEmit --skipLibCheck",
    "prettify": "prettier --write $(find src -name '*.ts')"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/paul-ridgway/ecs-utils.git"
  },
  "keywords": [
    "ecs",
    "utilities"
  ],
  "author": "Paul Ridgway",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/paul-ridgway/ecs-utils/issues"
  },
  "engines": {
    "node": ">=10.0.0",
    "npm": ">=6.0.0"
  },
  "homepage": "https://github.com/paul-ridgway/ecs-utils#readme",
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.666.0",
    "@aws-sdk/client-ssm": "^3.666.0",
    "fuzzy": "^0.1.3",
    "inquirer": "^9.1.2",
    "inquirer-autocomplete-prompt": "^3.0.1",
    "ora": "^5.3.0"
  },
  "devDependencies": {
    "@types/inquirer-autocomplete-prompt": "^3.0.3",
    "@types/node": "^22.7.5",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "@types/inquirer": "7.3.1"
  }
}
